            path="M 20 68 L 34 68 L 38 60 L 42 78 L 46 52 L 50 84 L 54 68 L 66 68 L 70 60 L 74 76 L 78 68 L 100 68"/>
    </circle>

    <!-- + bubbles rising above the heart -->
    <g stroke="#4ade80" stroke-width="1.4" stroke-linecap="round">
        <g>
            <line x1="44" y1="0" x2="44" y2="8"/>
            <line x1="40" y1="4" x2="48" y2="4"/>
