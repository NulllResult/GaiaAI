        <line x1="42" y1="90" x2="42" y2="100"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.6s"/></line>
        <line x1="60" y1="90" x2="60" y2="100"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.8s"/></line>
        <line x1="78" y1="90" x2="78" y2="100"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="1.0s"/></line>
        <line x1="20" y1="42" x2="30" y2="42"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.3s"/></line>
        <line x1="20" y1="60" x2="30" y2="60"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.5s"/></line>
        <line x1="20" y1="78" x2="30" y2="78"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.7s"/></line>
        <line x1="90" y1="42" x2="100" y2="42"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.9s"/></line>
