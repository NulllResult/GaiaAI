<section id="pipeline">
    <div class="container">
        <h2>The <span class="accent">pipeline</span></h2>
        <p class="lead">From raw genome to treatment protocol — one continuous line.</p>

        <div class="constellation">
            <svg viewBox="0 0 1200 460" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <radialGradient id="starHaloGrad" cx="50%" cy="50%" r="50%">
                        <stop offset="0%"   stop-color="#ffffff" stop-opacity="1"/>
                        <stop offset="25%"  stop-color="#a7f3d0" stop-opacity="0.7"/>
                        <stop offset="60%"  stop-color="#4ade80" stop-opacity="0.25"/>
                        <stop offset="100%" stop-color="#4ade80" stop-opacity="0"/>
                    </radialGradient>
                    <radialGradient id="travelerGrad" cx="50%" cy="50%" r="50%">
                        <stop offset="0%"   stop-color="#ffffff" stop-opacity="1"/>
                        <stop offset="35%"  stop-color="#a7f3d0" stop-opacity="0.85"/>
                        <stop offset="100%" stop-color="#4ade80" stop-opacity="0"/>
                    </radialGradient>
                    <radialGradient id="travelerGradBlue" cx="50%" cy="50%" r="50%">
                        <stop offset="0%"   stop-color="#ffffff" stop-opacity="1"/>
                        <stop offset="35%"  stop-color="#93c5fd" stop-opacity="0.85"/>
                        <stop offset="100%" stop-color="#60a5fa" stop-opacity="0"/>
                    </radialGradient>
                </defs>

                <!-- Primary constellation lines (green glow) -->
                <g>
                    <line class="link-glow" x1="120" y1="230" x2="390" y2="140"/>
                    <line class="link-glow" x1="390" y1="140" x2="620" y2="280"/>
                    <line class="link-glow" x1="620" y1="280" x2="850" y2="130"/>
                    <line class="link-glow" x1="850" y1="130" x2="1080" y2="230"/>
                </g>
                <g>
                    <line class="link" x1="120" y1="230" x2="390" y2="140"/>
                    <line class="link" x1="390" y1="140" x2="620" y2="280"/>
                    <line class="link" x1="620" y1="280" x2="850" y2="130"/>
                    <line class="link" x1="850" y1="130" x2="1080" y2="230"/>
                </g>

                <!-- Secondary cross links (blue, subtler) -->
                <g>
                    <line class="link-secondary" x1="120" y1="230" x2="620" y2="280"/>
                    <line class="link-secondary" x1="390" y1="140" x2="850" y2="130"/>
                    <line class="link-secondary" x1="620" y1="280" x2="1080" y2="230"/>
                    <line class="link-secondary" x1="120" y1="230" x2="390" y2="140"/>
                    <line class="link-secondary" x1="850" y1="130" x2="1080" y2="230"/>
                    <line class="link-secondary" x1="120" y1="230" x2="850" y2="130"/>
                    <line class="link-secondary" x1="390" y1="140" x2="1080" y2="230"/>
                </g>

                <!-- Orbital rings around the central star -->
                <circle class="orbit-ring"     cx="620" cy="280" r="80"/>
                <circle class="orbit-ring r2"  cx="620" cy="280" r="130"/>
                <circle class="orbit-ring r3"  cx="620" cy="280" r="180"/>

                <!-- Travelers, three -->
                <g class="constellation-traveler">
                    <circle class="constellation-traveler-halo" r="28">
                        <animateMotion dur="18s" repeatCount="indefinite"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                    <circle class="constellation-traveler" r="5">
                        <animateMotion dur="18s" repeatCount="indefinite"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                </g>
                <g class="constellation-traveler secondary">
                    <circle class="constellation-traveler-halo" r="22">
                        <animateMotion dur="18s" repeatCount="indefinite" begin="-6s"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                    <circle class="constellation-traveler" r="4">
                        <animateMotion dur="18s" repeatCount="indefinite" begin="-6s"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                </g>
                <g class="constellation-traveler tertiary">
                    <circle class="constellation-traveler-halo" r="20">
                        <animateMotion dur="18s" repeatCount="indefinite" begin="-12s"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                    <circle class="constellation-traveler" r="3.5">
                        <animateMotion dur="18s" repeatCount="indefinite" begin="-12s"
                            path="M120,230 L390,140 L620,280 L850,130 L1080,230"/>
                    </circle>
                </g>

                <!-- Dense star field (SVG decorative) -->
                <g fill="#ffffff" opacity="0.55">
                    <circle cx="60"   cy="80"  r="1.2"/>
                    <circle cx="150"  cy="340" r="1"/>
                    <circle cx="240"  cy="60"  r="1.4"/>
                    <circle cx="330"  cy="380" r="1"/>
                    <circle cx="420"  cy="80"  r="1.2"/>
                    <circle cx="500"  cy="360" r="1.1"/>
                    <circle cx="580"  cy="60"  r="1.3"/>
                    <circle cx="720"  cy="400" r="1"/>
                    <circle cx="800"  cy="50"  r="1.2"/>
                    <circle cx="900"  cy="380" r="1"/>
                    <circle cx="980"  cy="80"  r="1.3"/>
                    <circle cx="1080" cy="380" r="1"/>
                    <circle cx="1160" cy="120" r="1.1"/>
                    <circle cx="40"   cy="200" r="0.9"/>
                    <circle cx="240"  cy="180" r="0.8"/>
                    <circle cx="490"  cy="200" r="0.9"/>
                    <circle cx="740"  cy="220" r="0.8"/>
                    <circle cx="960"  cy="200" r="0.9"/>
                    <circle cx="1140" cy="320" r="0.8"/>
                </g>
                <g fill="#a7f3d0" opacity="0.5">
                    <circle cx="90"   cy="150" r="1.1"/>
                    <circle cx="280"  cy="120" r="1"/>
                    <circle cx="460"  cy="280" r="1.1"/>
                    <circle cx="700"  cy="120" r="1"/>
                    <circle cx="880"  cy="340" r="1.1"/>
                    <circle cx="1050" cy="60"  r="1"/>
                    <circle cx="180"  cy="290" r="0.9"/>
                    <circle cx="550"  cy="420" r="0.9"/>
                    <circle cx="1120" cy="290" r="0.9"/>
                </g>
                <g fill="#60a5fa" opacity="0.45">
                    <circle cx="300"  cy="60"  r="1.1"/>
                    <circle cx="450"  cy="120" r="1"/>
                    <circle cx="670"  cy="380" r="1"/>
                    <circle cx="870"  cy="60"  r="1.1"/>
                    <circle cx="1000" cy="300" r="1"/>
                    <circle cx="1100" cy="420" r="0.9"/>
                </g>

                <!-- Main stars -->
                <g class="star" transform="translate(120 230)">
                    <circle class="star-halo" r="46"/>
                    <circle class="star-core" r="8"/>
                </g>
                <g class="star" transform="translate(390 140)">
                    <circle class="star-halo" r="40"/>
                    <circle class="star-core" r="7"/>
                </g>
                <g class="star central" transform="translate(620 280)">
                    <circle class="star-halo" r="62"/>
                    <circle class="star-core" r="13"/>
                </g>
                <g class="star" transform="translate(850 130)">
                    <circle class="star-halo" r="40"/>
                    <circle class="star-core" r="7"/>
                </g>
                <g class="star" transform="translate(1080 230)">
                    <circle class="star-halo" r="46"/>
                    <circle class="star-core" r="8"/>
                </g>
            </svg>

            <div class="constellation-labels">
                <div class="constellation-label">
                    <span class="constellation-num">STAGE 01</span>
                    <h3>Read the genome</h3>
                    <p>Every window classified by structural signature — coding, conserved, regulatory, or silent.</p>
                </div>
                <div class="constellation-label">
                    <span class="constellation-num">STAGE 02</span>
                    <h3>Map the variants</h3>
                    <p>Population variation placed in context. Every variant associated with its gene, pathway, and evidence.</p>
                </div>
                <div class="constellation-label">
                    <span class="constellation-num">STAGE 03</span>
                    <h3>Screen the compounds</h3>
                    <p>Multiple libraries of small molecules and natural products, ranked by binding potential.</p>
                </div>
                <div class="constellation-label">
                    <span class="constellation-num">STAGE 04</span>
                    <h3>Score every interaction</h3>
                    <p>Multiple scoring approaches combined into one ranking. Physical, chemical, and contextual.</p>
                </div>
                <div class="constellation-label">
                    <span class="constellation-num">STAGE 05</span>
                    <h3>Design the protocol</h3>
                    <p>Multi-compound protocol with predicted outcomes across time. One ranking, one plan.</p>
                </div>
            </div>
        </div>

        <div class="sample-output">
            <div class="sample-output-header">
                <div class="dot-row"><span></span><span></span><span></span></div>
                <div class="title">sample output — ranked protocol</div>
            </div>
            <table>
                <tr>
                    <th>Rank</th>
                    <th>Compound</th>
                    <th>Binding</th>
                    <th>Evidence</th>
                    <th>Confidence</th>
                </tr>
                <tr>
                    <td>1</td>
                    <td>resveratrol</td>
                    <td class="score">−8.72</td>
                    <td class="evidence">in silico · in vitro · in vivo</td>
                    <td class="high">high</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>curcumin</td>
                    <td class="score">−7.91</td>
                    <td class="evidence">in silico · in vitro</td>
                    <td class="high">high</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>fisetin</td>
                    <td class="score">−7.45</td>
                    <td class="evidence">in silico · in vitro · in vivo</td>
                    <td class="high">high</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>berberine</td>
                    <td class="score">−6.83</td>
                    <td class="evidence">in silico · in vitro</td>
                    <td class="med">medium</td>
                </tr>
                <tr>
                    <td>5</td>
                    <td>quercetin</td>
                    <td class="score">−6.52</td>
                    <td class="evidence">in silico only</td>
                    <td class="med">medium</td>
                </tr>
            </table>
            <div class="note">
                → next: combine top 3 into a protocol, simulate outcomes at                30 / 90 / 180 / 365 days, generate full evidence report.
            </div>
        </div>
    </div>
</section>

<section id="capabilities">
    <div class="container">
        <h2>What it <span class="accent">does</span></h2>
        <p class="lead">
            Eight components. Each one is its own tile — hover or tap one to read its role.
        </p>

        <div class="tile-field">

            <!-- Scattered chemistry background layer -->
            <div class="chem-scatter" aria-hidden="true">
                <!-- Erlenmeyer flask (small) -->
                <div class="chem-mini" style="top: 8%; left: 4%; animation-delay: 0s;">
                    <svg viewBox="0 0 40 50" width="40" height="50" fill="none" stroke="#4ade80" stroke-width="0.9" stroke-linejoin="round">
                        <path d="M 15 6 L 15 20 L 4 45 Q 3 48 7 48 L 33 48 Q 37 48 36 45 L 25 20 L 25 6 Z"/>
                        <line x1="13" y1="6" x2="27" y2="6"/>
                    </svg>
                </div>
                <!-- Round-bottom flask -->
                <div class="chem-mini" style="top: 20%; right: 5%; animation-delay: -2s;">
                    <svg viewBox="0 0 40 50" width="40" height="50" fill="none" stroke="#60a5fa" stroke-width="0.9" stroke-linejoin="round">
                        <circle cx="20" cy="32" r="14"/>
                        <line x1="16" y1="10" x2="16" y2="20"/>
                        <line x1="24" y1="10" x2="24" y2="20"/>
                        <line x1="14" y1="10" x2="26" y2="10"/>
                    </svg>
                </div>
                <!-- Test tube (single) -->
                <div class="chem-mini" style="top: 48%; left: 6%; animation-delay: -4s;">
                    <svg viewBox="0 0 20 50" width="20" height="50" fill="none" stroke="#a7f3d0" stroke-width="0.9" stroke-linejoin="round">
                        <rect x="6" y="4" width="8" height="40" rx="4"/>
                        <line x1="3" y1="4" x2="17" y2="4"/>
                    </svg>
                </div>
                <!-- Beaker -->
                <div class="chem-mini" style="bottom: 10%; left: 8%; animation-delay: -6s;">
                    <svg viewBox="0 0 40 46" width="40" height="46" fill="none" stroke="#34d399" stroke-width="0.9" stroke-linejoin="round">
                        <path d="M 7 5 L 7 38 Q 7 41 10 41 L 30 41 Q 33 41 33 38 L 33 5"/>
                        <line x1="5" y1="5" x2="35" y2="5"/>
                    </svg>
                </div>
                <!-- Bunsen burner (tiny) -->
                <div class="chem-mini" style="bottom: 20%; right: 6%; animation-delay: -3s;">
                    <svg viewBox="0 0 30 50" width="30" height="50" fill="none" stroke="#fbbf24" stroke-width="0.9" stroke-linejoin="round">
                        <path d="M 10 40 L 20 40 L 17 30 L 13 30 Z"/>
                        <line x1="7" y1="40" x2="23" y2="40"/>
                        <line x1="15" y1="30" x2="15" y2="22"/>
                        <path d="M 11 16 Q 15 4 19 16 Q 15 14 11 16 Z"/>
                    </svg>
                </div>
                <!-- Benzene ring -->
                <div class="chem-mini" style="top: 68%; left: 4%; animation-delay: -5s;">
                    <svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#4ade80" stroke-width="0.9" stroke-linejoin="round">
                        <polygon points="20,4 34,12 34,28 20,36 6,28 6,12"/>
                        <circle cx="20" cy="20" r="7" stroke-dasharray="2 3"/>
                    </svg>
                </div>
                <!-- Droplet -->
                <div class="chem-mini" style="top: 32%; left: 48%; animation-delay: -7s;">
                    <svg viewBox="0 0 20 30" width="20" height="30" fill="none" stroke="#93c5fd" stroke-width="0.9" stroke-linejoin="round">
                        <path d="M 10 3 Q 18 14 18 21 A 8 8 0 0 1 2 21 Q 2 14 10 3 Z"/>
                    </svg>
                </div>
                <!-- Pipette -->
                <div class="chem-mini" style="top: 60%; right: 8%; animation-delay: -8s;">
                    <svg viewBox="0 0 14 60" width="14" height="60" fill="none" stroke="#a7f3d0" stroke-width="0.9" stroke-linejoin="round">
                        <rect x="4" y="4" width="6" height="30" rx="1"/>
                        <line x1="7" y1="34" x2="7" y2="54"/>
                    </svg>
                </div>
                <!-- Molecule (three atoms) -->
                <div class="chem-mini" style="top: 82%; right: 20%; animation-delay: -9s;">
                    <svg viewBox="0 0 40 30" width="40" height="30" fill="none" stroke="#4ade80" stroke-width="0.9">
                        <circle cx="10" cy="15" r="5"/>
