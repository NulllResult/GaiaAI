             C 44 22 16 30 16 52
             C 16 76 46 92 60 106
             C 74 92 104 76 104 52
             C 104 30 76 22 60 44 Z"
          fill="#0e1a14" stroke="#a7f3d0" stroke-width="1.8" stroke-linejoin="round"/>

