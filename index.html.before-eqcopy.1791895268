             fill="none" stroke="#93c5fd" stroke-width="1" opacity="0.6"/>
    <!-- orbital ring 3 (diagonal) -->
    <ellipse cx="60" cy="60" rx="46" ry="14"
             fill="none" stroke="#a7f3d0" stroke-width="1" opacity="0.5"
             transform="rotate(-60 60 60)"/>

    <!-- electrons orbiting -->
    <circle r="3" fill="#4ade80">
        <animateMotion dur="4s" repeatCount="indefinite"
            path="M 14 60 A 46 14 0 1 1 13.9 60 Z"/>
    </circle>
    <circle r="3" fill="#93c5fd">
        <animateMotion dur="5s" repeatCount="indefinite"
            path="M 60 14 A 14 46 0 1 1 59.9 14 Z"/>
    </circle>
    <circle r="3" fill="#a7f3d0">
        <animateMotion dur="6s" repeatCount="indefinite"
            path="M 20 94 L 100 26"/>
    </circle>

    <!-- bonded atoms (small dots around the ring) -->
    <g fill="#a7f3d0" opacity="0.85">
        <circle cx="60" cy="14" r="2.5"/>
        <circle cx="60" cy="106" r="2.5"/>
        <circle cx="14" cy="60" r="2.5"/>
        <circle cx="106" cy="60" r="2.5"/>
    </g>

    <!-- electron sparks leaving the nucleus -->
