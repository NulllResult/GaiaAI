        <animate attributeName="opacity" values="0.5;0" dur="1.8s" repeatCount="indefinite"/>
    </circle>
    <circle cx="60" cy="60" r="3" fill="#ffffff">
        <animate attributeName="r" values="2.5;3.5;2.5" dur="1.2s" repeatCount="indefinite"/>
    </circle>

    <!-- pins with soft glow -->
    <g stroke="#4ade80" stroke-width="1.8" stroke-linecap="round">
        <line x1="42" y1="20" x2="42" y2="30"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0s"/></line>
        <line x1="60" y1="20" x2="60" y2="30"><animate attributeName="opacity" values="0.3;1;0.3" dur="2s" repeatCount="indefinite" begin="0.2s"/></line>
