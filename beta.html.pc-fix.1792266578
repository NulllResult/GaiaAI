    text-decoration: none !important;
    opacity: 0.75 !important;
}
</style>
<style>
/* ============================================================
   ISOLATE FROM assets/style.css — reset everything it sets
   that could vary by viewport
   ============================================================ */
html, body {
    margin: 0 !important;
    padding: 0 !important;
    min-height: 0 !important;
    height: auto !important;
    overflow-x: hidden !important;
    background: #06120c !important;
}
body > * {
    position: relative;
}
/* Force every top-level wrapper to be the same on all viewports */
body > .beta-hero {
    max-width: none !important;
}
</style>
</head>
<body class="beta-page">
<canvas id="gaia-bg-canvas" aria-hidden="true"></canvas>

<script>
(function () {
    const canvas = document.getElementById('gaia-bg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H, DPR;
    let particles = [];

    // Config — tuned to feel dense but readable
    const CONFIG = {
        count: 90,               // node count (density)
        maxLinkDist: 160,        // px — how far apart nodes still connect
        speed: 0.35,             // drift speed
        nodeRadius: [1.4, 3.2],  // min/max node radius
        colors: [
            'rgba(74, 222, 128, ',   // green
            'rgba(167, 243, 208, ',  // mint
            'rgba(96, 165, 250, ',   // blue
            'rgba(52, 211, 153, ',   // teal
        ],
        linkOpacity: 0.18,       // base line opacity
        nodeOpacity: 0.75,
    };

    function resize() {
        DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width = W * DPR;
        canvas.height = H * DPR;
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    function rand(a, b) { return a + Math.random() * (b - a); }

    function makeParticle() {
        const homeX = Math.random() * W;
        const homeY = Math.random() * H;
        return {
            homeX: homeX,
            homeY: homeY,
            x: homeX,
            y: homeY,
            ampX: rand(4, 14),
            ampY: rand(4, 14),
            freqX: rand(0.0004, 0.0012),
            freqY: rand(0.0004, 0.0012),
            t: Math.random() * 1000,
            r: rand(CONFIG.nodeRadius[0], CONFIG.nodeRadius[1]),
            color: CONFIG.colors[Math.floor(Math.random() * CONFIG.colors.length)],
            phase: Math.random() * Math.PI * 2,
            pulseSpeed: rand(0.008, 0.02),
        };
    }

    function initParticles() {
        particles = [];
        // scale count with screen area so density is consistent
        const area = W * H;
        const base = 400000;
        const n = Math.max(40, Math.min(140, Math.round(CONFIG.count * (area / base))));
        for (let i = 0; i < n; i++) particles.push(makeParticle());
    }

    // Flow particles — always a few moving fast along the network
    const flows = [];
    function initFlows() {
        flows.length = 0;
        for (let i = 0; i < 6; i++) {
            flows.push({
                a: particles[Math.floor(Math.random() * particles.length)],
                b: particles[Math.floor(Math.random() * particles.length)],
                t: Math.random(),
                speed: rand(0.004, 0.009),
            });
        }
    }

    function step() {
        ctx.clearRect(0, 0, W, H);

        // Update positions — oscillate around home
        for (const p of particles) {
            p.t += 1;
            p.x = p.homeX + Math.sin(p.t * p.freqX) * p.ampX;
            p.y = p.homeY + Math.cos(p.t * p.freqY) * p.ampY;
            p.phase += p.pulseSpeed;
        }

        // Draw edges first (under nodes)
        for (let i = 0; i < particles.length; i++) {
            const a = particles[i];
            for (let j = i + 1; j < particles.length; j++) {
                const b = particles[j];
                const dx = a.x - b.x, dy = a.y - b.y;
                const d2 = dx * dx + dy * dy;
                if (d2 > CONFIG.maxLinkDist * CONFIG.maxLinkDist) continue;
                const d = Math.sqrt(d2);
                const alpha = (1 - d / CONFIG.maxLinkDist) * CONFIG.linkOpacity;
                ctx.strokeStyle = 'rgba(74, 222, 128, ' + alpha.toFixed(3) + ')';
                ctx.lineWidth = 0.6;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
            }
        }

        // Draw nodes with pulse
        for (const p of particles) {
            const pulse = 0.85 + 0.35 * Math.sin(p.phase);
            const r = p.r * pulse;
            ctx.fillStyle = p.color + CONFIG.nodeOpacity + ')';
            ctx.beginPath();
            ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
            ctx.fill();
            // subtle glow
            ctx.fillStyle = p.color + '0.12)';
            ctx.beginPath();
            ctx.arc(p.x, p.y, r * 3.5, 0, Math.PI * 2);
            ctx.fill();
        }

        // Flow particles along network edges
        for (const f of flows) {
            f.t += f.speed;
            if (f.t >= 1) {
                f.t = 0;
                f.a = particles[Math.floor(Math.random() * particles.length)];
                f.b = particles[Math.floor(Math.random() * particles.length)];
            }
            const x = f.a.x + (f.b.x - f.a.x) * f.t;
            const y = f.a.y + (f.b.y - f.a.y) * f.t;
            // fade in/out over the trip
            const alpha = Math.sin(f.t * Math.PI);
            ctx.fillStyle = 'rgba(255, 255, 255, ' + (0.9 * alpha).toFixed(3) + ')';
            ctx.beginPath();
            ctx.arc(x, y, 2.4, 0, Math.PI * 2);
            ctx.fill();
        }

        requestAnimationFrame(step);
    }

    window.addEventListener('resize', () => { resize(); initParticles(); initFlows(); });
    resize();
    initParticles();
    initFlows();
    step();
})();
</script>
<div class="beta-hero">
    <h1>GAIA <span class="accent">Beta Access</span></h1>
    <p>
        GAIA is in closed beta. Request access to run the full pipeline on
        your own data — genome read, variant mapping, compound ranking,
        protocol design, and the reversal simulation.
    </p>

    <form class="beta-form" action="#" method="POST" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Request received — we\'ll be in touch'; this.querySelector('button').disabled=true; this.querySelector('button').style.opacity=0.7;">
        <input type="email" name="email" placeholder="you@example.com" required>
        <input type="text" name="affiliation" placeholder="Affiliation (optional)">
        <textarea name="use_case" placeholder="What would you use GAIA for? (optional)"></textarea>
        <button type="submit">Request beta access</button>
    </form>

    <p class="beta-note">No email yet — access requests will be collected and followed up manually.</p>

    <div class="beta-promise">
        <h3>What beta access includes</h3>
        <ul>
            <li>Full access to the genome-scanning pipeline</li>
            <li>Compound library screening across 25M+ molecules</li>
            <li>The reversal simulation — run protocols on your own disease model</li>
            <li>All datasets, all benchmarks, all intermediate outputs</li>
            <li>Direct line for feedback — the system is built by one person</li>
        </ul>
    </div>

    <a href="index.html" class="beta-back">← Back to GAIA</a>
</div>


<div id="earth-container" aria-hidden="true"></div>

<!-- Real Earth (Three.js + NASA Blue Marble texture) -->
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';

const container = document.getElementById('earth-container');
if (container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);
    camera.position.z = 3.2;
    camera.position.y = 0.2;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // ----- Earth sphere -----
    const earthGeo = new THREE.SphereGeometry(1, 64, 64);
    const textureLoader = new THREE.TextureLoader();
    // NASA Blue Marble (public domain) — high-res day map
    const earthTex = textureLoader.load(
        'https://unpkg.com/three-globe@2.31.0/example/img/earth-blue-marble.jpg',
        undefined, undefined,
        (e) => console.warn('earth texture failed', e)
    );
    earthTex.colorSpace = THREE.SRGBColorSpace;

    const earthMat = new THREE.MeshPhongMaterial({
        map: earthTex,
        specular: new THREE.Color(0x333333),
        shininess: 15,
    });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    scene.add(earth);

    // ----- clouds layer (slightly larger sphere with alpha) -----
    const cloudTex = textureLoader.load(
        'https://unpkg.com/three-globe@2.31.0/example/img/clouds.png',
        undefined, undefined,
        () => {} // clouds optional, no error if missing
    );
    if (cloudTex) {
        cloudTex.colorSpace = THREE.SRGBColorSpace;
        const cloudMat = new THREE.MeshPhongMaterial({
            map: cloudTex,
            transparent: true,
            opacity: 0.55,
            depthWrite: false,
        });
        const clouds = new THREE.Mesh(new THREE.SphereGeometry(1.005, 64, 64), cloudMat);
        scene.add(clouds);
        clouds.name = 'clouds';
    }

    // ----- atmospheric rim glow -----
    const atmoMat = new THREE.MeshBasicMaterial({
        color: 0x4ade80,
        transparent: true,
        opacity: 0.18,
        side: THREE.BackSide,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
    });
    const atmo = new THREE.Mesh(new THREE.SphereGeometry(1.14, 64, 64), atmoMat);
    scene.add(atmo);

    // ----- lighting: sun from upper-left, rim light from right -----
    // Sun — slightly green-tinted white
    const sun = new THREE.DirectionalLight(0xd8ffe8, 2.4);
    sun.position.set(-3, 2, 2);
    scene.add(sun);

    // Ambient — green so the shadowed side stays on-theme
    const ambient = new THREE.AmbientLight(0x1a3a28, 1.5);
    scene.add(ambient);

    // Rim light — GAIA green
    const rim = new THREE.DirectionalLight(0x4ade80, 1.0);
    rim.position.set(2, -1, -3);
    scene.add(rim);

    // ====== GAIA THEME TINT ======
    // Green "sci-fi overlay" sphere slightly larger than earth.
    // Additive so the surface detail is preserved, but tinted green.
    const tintMat = new THREE.MeshBasicMaterial({
        color: 0x4ade80,
        transparent: true,
        opacity: 0.22,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        side: THREE.FrontSide,
    });
    const tint = new THREE.Mesh(new THREE.SphereGeometry(1.002, 64, 64), tintMat);
    scene.add(tint);

    // Second tint — a brighter mint just along the limb, to make edges glow.
    const edgeMat = new THREE.MeshBasicMaterial({
        color: 0xa7f3d0,
        transparent: true,
        opacity: 0.18,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        side: THREE.BackSide,
    });
    const edge = new THREE.Mesh(new THREE.SphereGeometry(1.06, 64, 64), edgeMat);
    scene.add(edge);

    // ----- sizing: positioned at bottom of page, mostly cut off -----
    function resize() {
        const w = container.clientWidth;
        const h = container.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
    }
    window.addEventListener('resize', resize);
    resize();

    // ----- animation: rotate earth, drift clouds faster -----
    let t = 0;
    function tick() {
        t += 0.0016;
        earth.rotation.y = t;
        const clouds = scene.getObjectByName('clouds');
        if (clouds) clouds.rotation.y = t * 1.18;
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
    }
    tick();
}
</script>

</body>
</html>
