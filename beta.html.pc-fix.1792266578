    margin: 0 auto 32px auto !important;
}
html body .beta-form {
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    max-width: 440px !important;
    width: 100% !important;
    margin: 0 auto !important;
}
html body .beta-form input,
html body .beta-form textarea {
    width: 100% !important;
    padding: 14px 18px !important;
    background: rgba(14,26,20,0.6) !important;
    border: 1px solid rgba(74,222,128,0.28) !important;
    border-radius: 8px !important;
    color: var(--fg) !important;
    font-family: inherit !important;
    font-size: 0.98rem !important;
    outline: none !important;
    box-sizing: border-box !important;
}
html body .beta-form textarea {
    min-height: 100px !important;
    resize: vertical !important;
}
html body .beta-form button {
    padding: 14px 24px !important;
    background: linear-gradient(135deg, #4ade80, #34d399) !important;
    border: none !important;
    border-radius: 8px !important;
    color: #0a1410 !important;
    font-family: inherit !important;
    font-size: 0.98rem !important;
    font-weight: 600 !important;
    cursor: pointer !important;
}
html body .beta-note {
    font-size: 0.82rem !important;
