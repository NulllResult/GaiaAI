<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GAIA — Beta Access</title>
<meta name="description" content="Request access to the GAIA closed beta.">
<link rel="stylesheet" href="assets/style.css?v=111">
<style>
/* ============================================================
   GAIA BETA — CANONICAL LAYOUT (FIXED)
   ============================================================ */
body::before, body::after { display: none !important; content: none !important; }
html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: #06120c; overflow: hidden !important; }

/* 1. Background Network */
body > canvas#gaia-bg-canvas {
    position: fixed; inset: 0; width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none;
}

/* 2. The Form Container (Fixed in center) */
.beta-hero {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    z-index: 10 !important;
    width: 100% !important;
    max-width: 500px !important;
    height: 90vh !important;
    overflow-y: auto !important; /* Only the form scrolls if needed */
    padding: 24px !important;
    display: flex; flex-direction: column; justify-content: center;
}

/* 3. The Earth (Pushed way down so it's just a curve) */
#earth-container {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 50vh !important; /* Only bottom half of screen */
    z-index: 1 !important;
    pointer-events: none !important;
}

/* 4. Typography & Form Styling */
.beta-hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: 0; margin-bottom: 20px; text-align: center; color: #fff; }
.beta-hero p { font-size: 1.05rem; line-height: 1.6; margin-bottom: 32px; text-align: center; color: #8fa89c; }
.beta-form { width: 100%; display: flex; flex-direction: column; gap: 14px; }
.beta-form input, .beta-form textarea { width: 100%; padding: 14px 18px; background: rgba(14,26,20,0.8); border: 1px solid rgba(74,222,128,0.28); border-radius: 8px; color: #fff; font-family: inherit; font-size: 1rem; }
.beta-form textarea { min-height: 80px; resize: vertical; }
.beta-form button { padding: 14px 24px; background: linear-gradient(135deg, #4ade80, #34d399); border: none; border-radius: 8px; color: #0a1410; font-weight: 600; cursor: pointer; }
.beta-promise { margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(74,222,128,0.15); width: 100%; }
.beta-promise h3 { font-family: ui-monospace, monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: #4ade80; margin-bottom: 16px; }
.beta-promise ul { list-style: none; padding: 0; display: grid; gap: 10px; }
.beta-promise li { font-size: 0.92rem; color: #8fa89c; padding-left: 22px; position: relative; }
.beta-promise li::before { content: "→"; position: absolute; left: 0; color: #4ade80; }
.beta-back { display: block; margin-top: 30px; text-align: center; font-family: ui-monospace, monospace; font-size: 0.85rem; color: #4ade80; text-decoration: none; }
</style>
<style>
/* ============================================================
   MOBILE DESKTOP-MODE LOCK (Beta Page)
   Forces mobile layout even if the phone requests "Desktop site"
   ============================================================ */
@media (hover: none) and (pointer: coarse) {
    /* Lock scrolling */
    html, body {
        overflow: hidden !important;
        height: 100% !important;
        width: 100% !important;
    }

    /* Fix the form to be centered and narrow */
    .beta-hero {
        position: fixed !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: 100% !important;
        max-width: 500px !important;
        height: 90vh !important;
        overflow-y: auto !important;
        padding: 24px !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
        z-index: 10 !important;
    }

    /* Make the Earth curve exactly like normal mobile view */
    #earth-container {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 50vh !important;
        z-index: 1 !important;
        pointer-events: none !important;
    }

    /* Fix text sizes that desktop mode tries to shrink */
    .beta-hero h1 { font-size: 2.5rem !important; }
    .beta-hero p { font-size: 1rem !important; }
    .beta-form input, .beta-form textarea { font-size: 16px !important; } /* Prevents iOS auto-zoom */
}
</style>
</head>
<body>

<canvas id="gaia-bg-canvas" aria-hidden="true"></canvas>

<script>
(function () {
    const canvas = document.getElementById('gaia-bg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H, DPR;
    let particles = [];
    const CONFIG = { count: 90, maxLinkDist: 160, speed: 0.35, nodeRadius: [1.4, 3.2], colors: ['rgba(74, 222, 128, ', 'rgba(167, 243, 208, ', 'rgba(96, 165, 250, ', 'rgba(52, 211, 153, '], linkOpacity: 0.18, nodeOpacity: 0.75 };
    function resize() { DPR = Math.min(window.devicePixelRatio || 1, 2); W = window.innerWidth; H = window.innerHeight; canvas.width = W * DPR; canvas.height = H * DPR; canvas.style.width = W + 'px'; canvas.style.height = H + 'px'; ctx.setTransform(DPR, 0, 0, DPR, 0, 0); }
    function rand(a, b) { return a + Math.random() * (b - a); }
    function makeParticle() { const homeX = Math.random() * W; const homeY = Math.random() * H; return { homeX, homeY, x: homeX, y: homeY, ampX: rand(4, 14), ampY: rand(4, 14), freqX: rand(0.0004, 0.0012), freqY: rand(0.0004, 0.0012), t: Math.random() * 1000, r: rand(CONFIG.nodeRadius[0], CONFIG.nodeRadius[1]), color: CONFIG.colors[Math.floor(Math.random() * CONFIG.colors.length)], phase: Math.random() * Math.PI * 2, pulseSpeed: rand(0.008, 0.02) }; }
    function initParticles() { particles = []; const area = W * H; const n = Math.max(40, Math.min(140, Math.round(CONFIG.count * (area / 400000)))); for (let i = 0; i < n; i++) particles.push(makeParticle()); }
    const flows = [];
    function initFlows() { flows.length = 0; for (let i = 0; i < 6; i++) { flows.push({ a: particles[Math.floor(Math.random() * particles.length)], b: particles[Math.floor(Math.random() * particles.length)], t: Math.random(), speed: rand(0.004, 0.009) }); } }
    function step() { ctx.clearRect(0, 0, W, H); for (const p of particles) { p.t += 1; p.x = p.homeX + Math.sin(p.t * p.freqX) * p.ampX; p.y = p.homeY + Math.cos(p.t * p.freqY) * p.ampY; p.phase += p.pulseSpeed; }
        for (let i = 0; i < particles.length; i++) { const a = particles[i]; for (let j = i + 1; j < particles.length; j++) { const b = particles[j]; const dx = a.x - b.x, dy = a.y - b.y; const d2 = dx * dx + dy * dy; if (d2 > CONFIG.maxLinkDist * CONFIG.maxLinkDist) continue; const d = Math.sqrt(d2); const alpha = (1 - d / CONFIG.maxLinkDist) * CONFIG.linkOpacity; ctx.strokeStyle = 'rgba(74, 222, 128, ' + alpha.toFixed(3) + ')'; ctx.lineWidth = 0.6; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); } }
        for (const p of particles) { const pulse = 0.85 + 0.35 * Math.sin(p.phase); const r = p.r * pulse; ctx.fillStyle = p.color + CONFIG.nodeOpacity + ')'; ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = p.color + '0.12)'; ctx.beginPath(); ctx.arc(p.x, p.y, r * 3.5, 0, Math.PI * 2); ctx.fill(); }
        for (const f of flows) { f.t += f.speed; if (f.t >= 1) { f.t = 0; f.a = particles[Math.floor(Math.random() * particles.length)]; f.b = particles[Math.floor(Math.random() * particles.length)]; } const x = f.a.x + (f.b.x - f.a.x) * f.t; const y = f.a.y + (f.b.y - f.a.y) * f.t; const alpha = Math.sin(f.t * Math.PI); ctx.fillStyle = 'rgba(255, 255, 255, ' + (0.9 * alpha).toFixed(3) + ')'; ctx.beginPath(); ctx.arc(x, y, 2.4, 0, Math.PI * 2); ctx.fill(); }
        requestAnimationFrame(step); }
    window.addEventListener('resize', () => { resize(); initParticles(); initFlows(); }); resize(); initParticles(); initFlows(); step();
})();
</script>

<div class="beta-hero">
    <h1>GAIA <span class="accent">Beta Access</span></h1>
    <p>GAIA is in closed beta. Request access to run the full pipeline on your own data — genome read, variant mapping, compound ranking, protocol design, and the reversal simulation.</p>
    <form class="beta-form" action="#" method="POST" onsubmit="event.preventDefault(); this.querySelector('button').textContent='Request received'; this.querySelector('button').disabled=true;">
        <input type="email" name="email" placeholder="you@example.com" required>
        <input type="text" name="affiliation" placeholder="Affiliation (optional)">
        <textarea name="use_case" placeholder="What would you use GAIA for? (optional)"></textarea>
        <button type="submit">Request beta access</button>
    </form>
    <p style="font-family: ui-monospace; font-size: 0.82rem; color: rgba(167,243,208,0.5); margin-top: 24px;">No email yet — access requests will be collected and followed up manually.</p>
    <div class="beta-promise">
        <h3>What beta access includes</h3>
        <ul>
            <li>Full access to the genome-scanning pipeline</li>
            <li>Compound library screening across 25M+ molecules</li>
            <li>The reversal simulation — run protocols on your own disease model</li>
            <li>All datasets, all benchmarks, all intermediate outputs</li>
            <li>Direct line for feedback — the system is built by one person</li>
        </ul>
    </div>
    <a href="index.html" class="beta-back">← Back to GAIA</a>
</div>

<div id="earth-container" aria-hidden="true"></div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
const container = document.getElementById('earth-container');
if (container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 1000);
    // Move camera closer to make Earth massive
    camera.position.z = 2.2; 
    camera.position.y = -0.4;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const earthGeo = new THREE.SphereGeometry(1, 64, 64);
    const textureLoader = new THREE.TextureLoader();
    const earthTex = textureLoader.load('https://unpkg.com/three-globe@2.31.0/example/img/earth-blue-marble.jpg');
    earthTex.colorSpace = THREE.SRGBColorSpace;
    const earthMat = new THREE.MeshPhongMaterial({ map: earthTex, specular: new THREE.Color(0x333333), shininess: 15 });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    scene.add(earth);

    const cloudTex = textureLoader.load('https://unpkg.com/three-globe@2.31.0/example/img/clouds.png');
    cloudTex.colorSpace = THREE.SRGBColorSpace;
    const cloudMat = new THREE.MeshPhongMaterial({ map: cloudTex, transparent: true, opacity: 0.55, depthWrite: false });
    const clouds = new THREE.Mesh(new THREE.SphereGeometry(1.005, 64, 64), cloudMat);
    scene.add(clouds); clouds.name = 'clouds';

    const tintMat = new THREE.MeshBasicMaterial({ color: 0x4ade80, transparent: true, opacity: 0.15, blending: THREE.AdditiveBlending, depthWrite: false });
    const tint = new THREE.Mesh(new THREE.SphereGeometry(0.998, 64, 64), tintMat);
    scene.add(tint);

    const atmoMat = new THREE.MeshBasicMaterial({ color: 0x4ade80, transparent: true, opacity: 0.18, side: THREE.BackSide, blending: THREE.AdditiveBlending, depthWrite: false });
    const atmo = new THREE.Mesh(new THREE.SphereGeometry(1.14, 64, 64), atmoMat);
    scene.add(atmo);

    const sun = new THREE.DirectionalLight(0xd8ffe8, 2.4); sun.position.set(-3, 2, 2); scene.add(sun);
    const ambient = new THREE.AmbientLight(0x1a3a28, 1.5); scene.add(ambient);
    const rim = new THREE.DirectionalLight(0x4ade80, 1.0); rim.position.set(2, -1, -3); scene.add(rim);

    function resize() {
        const w = container.clientWidth; const h = container.clientHeight;
        renderer.setSize(w, h);
        camera.aspect = w / h; camera.updateProjectionMatrix();
    }
    window.addEventListener('resize', resize); resize();

    let t = 0;
    function tick() {
        t += 0.0016; earth.rotation.y = t;
        const c = scene.getObjectByName('clouds'); if (c) c.rotation.y = t * 1.18;
        renderer.render(scene, camera); requestAnimationFrame(tick);
    }
    tick();
}
</script>
</body>
</html>
