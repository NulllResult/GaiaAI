<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GAIA — Beta Access</title>
<link rel="stylesheet" href="assets/style.css?v=220">
<style>
/* ============================================================
   GAIA BETA — SINGLE CANONICAL LAYOUT (NO SCROLL, SMOOTH EARTH)
   ============================================================ */

/* 1. Kill all main site artifacts */
body::before, body::after { display: none !important; content: none !important; }

/* 2. Lock the page completely */
html, body {
    margin: 0; padding: 0;
    width: 100vw; height: 100vh;
    overflow: hidden !important; /* NEVER SCROLL */
    background: #06120c;
}

/* 3. Background Network */
body > canvas#gaia-bg-canvas {
    position: fixed; inset: 0; width: 100vw; height: 100vh;
    z-index: 0; pointer-events: none;
}

/* 4. The Earth Container */
#earth-container {
    position: fixed; /* FIXED, not absolute */
    bottom: -15vh;
    left: 0;
    width: 100vw;
    height: 65vh;
    z-index: 1;
    pointer-events: none;
}

/* 5. The Form (Centered, Fits Screen, No Scroll) */
.beta-hero {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 520px; /* Narrower to fit vertically */
    max-height: 90vh; /* Fits on screen */
    overflow: hidden; /* No scroll on the form */
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
    text-align: center;
}

/* Typography scaled down to fit 1080p screens */
.beta-hero h1 { font-size: 2rem; margin: 0 0 12px 0; color: #fff; }
.beta-hero p { font-size: 0.9rem; color: #8fa89c; margin-bottom: 20px; line-height: 1.5; }

.beta-form { width: 100%; display: flex; flex-direction: column; gap: 10px; }
.beta-form input, .beta-form textarea {
    width: 100%; padding: 10px 14px; font-size: 0.9rem;
    background: rgba(14,26,20,0.8); border: 1px solid rgba(74,222,128,0.3);
    border-radius: 6px; color: #fff; font-family: inherit;
}
.beta-form textarea { min-height: 60px; resize: none; }
.beta-form button {
    padding: 12px; font-size: 0.95rem;
    background: linear-gradient(135deg, #4ade80, #34d399);
    border: none; border-radius: 6px; color: #0a1410;
    font-weight: 600; cursor: pointer;
}

.beta-promise { margin-top: 16px; padding-top: 12px; border-top: 1px solid rgba(74,222,128,0.15); width: 100%; text-align: left; }
.beta-promise h3 { font-family: ui-monospace, monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: #4ade80; margin-bottom: 8px; }
.beta-promise ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
.beta-promise li { font-size: 0.8rem; color: #8fa89c; padding-left: 18px; position: relative; }
.beta-promise li::before { content: "→"; position: absolute; left: 0; color: #4ade80; }

.beta-back { display: block; margin-top: 16px; font-family: ui-monospace, monospace; font-size: 0.8rem; color: #4ade80; text-decoration: none; }
</style>
<style>
/* ============================================================
   DEFINITIVE LAYOUT: FORM CENTERED, EARTH FIXED AT BOTTOM
   ============================================================ */
body::before, body::after { display: none !important; content: none !important; }
html, body { margin: 0; padding: 0; width: 100vw; height: 100vh; overflow: hidden; background: #06120c; }

/* 1. The Form */
.beta-hero {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: 100% !important;
    max-width: 640px !important;
    padding: 40px !important;
    z-index: 10 !important;
    display: flex; flex-direction: column; align-items: center;
}

/* 2. The Earth Container - Fixed to viewport, not scrolling with form */
#earth-container {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 50vh !important; /* Takes up bottom 50% of screen */
    z-index: 1 !important;
    pointer-events: none !important;
}

/* 3. Mobile adjustments */
@media (max-width: 768px) {
    .beta-hero { max-width: 90% !important; padding: 20px !important; }
    #earth-container { height: 40vh !important; }
}
</style></head>
<body>

<canvas id="gaia-bg-canvas" aria-hidden="true"></canvas>

<script>
(function () {
    const canvas = document.getElementById('gaia-bg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H, DPR;
    let particles = [];
    const CONFIG = { count: 90, maxLinkDist: 160, speed: 0.35, nodeRadius: [1.4, 3.2], colors: ['rgba(74, 222, 128, ', 'rgba(167, 243, 208, ', 'rgba(96, 165, 250, ', 'rgba(52, 211, 153, '], linkOpacity: 0.18, nodeOpacity: 0.75 };
    function resize() { DPR = Math.min(window.devicePixelRatio || 1, 2); W = window.innerWidth; H = window.innerHeight; canvas.width = W * DPR; canvas.height = H * DPR; canvas.style.width = W + 'px'; canvas.style.height = H + 'px'; ctx.setTransform(DPR, 0, 0, DPR, 0, 0); }
    function rand(a, b) { return a + Math.random() * (b - a); }
    function makeParticle() { const homeX = Math.random() * W; const homeY = Math.random() * H; return { homeX, homeY, x: homeX, y: homeY, ampX: rand(4, 14), ampY: rand(4, 14), freqX: rand(0.0004, 0.0012), freqY: rand(0.0004, 0.0012), t: Math.random() * 1000, r: rand(CONFIG.nodeRadius[0], CONFIG.nodeRadius[1]), color: CONFIG.colors[Math.floor(Math.random() * CONFIG.colors.length)], phase: Math.random() * Math.PI * 2, pulseSpeed: rand(0.008, 0.02) }; }
    function initParticles() { particles = []; const area = W * H; const n = Math.max(40, Math.min(140, Math.round(CONFIG.count * (area / 400000)))); for (let i = 0; i < n; i++) particles.push(makeParticle()); }
    const flows = [];
    function initFlows() { flows.length = 0; for (let i = 0; i < 6; i++) { flows.push({ a: particles[Math.floor(Math.random() * particles.length)], b: particles[Math.floor(Math.random() * particles.length)], t: Math.random(), speed: rand(0.004, 0.009) }); } }
    function step() { ctx.clearRect(0, 0, W, H); for (const p of particles) { p.t += 1; p.x = p.homeX + Math.sin(p.t * p.freqX) * p.ampX; p.y = p.homeY + Math.cos(p.t * p.freqY) * p.ampY; p.phase += p.pulseSpeed; }
        for (let i = 0; i < particles.length; i++) { const a = particles[i]; for (let j = i + 1; j < particles.length; j++) { const b = particles[j]; const dx = a.x - b.x, dy = a.y - b.y; const d2 = dx * dx + dy * dy; if (d2 > CONFIG.maxLinkDist * CONFIG.maxLinkDist) continue; const d = Math.sqrt(d2); const alpha = (1 - d / CONFIG.maxLinkDist) * CONFIG.linkOpacity; ctx.strokeStyle = 'rgba(74, 222, 128, ' + alpha.toFixed(3) + ')'; ctx.lineWidth = 0.6; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); } }
        for (const p of particles) { const pulse = 0.85 + 0.35 * Math.sin(p.phase); const r = p.r * pulse; ctx.fillStyle = p.color + CONFIG.nodeOpacity + ')'; ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill(); ctx.fillStyle = p.color + '0.12)'; ctx.beginPath(); ctx.arc(p.x, p.y, r * 3.5, 0, Math.PI * 2); ctx.fill(); }
        for (const f of flows) { f.t += f.speed; if (f.t >= 1) { f.t = 0; f.a = particles[Math.floor(Math.random() * particles.length)]; f.b = particles[Math.floor(Math.random() * particles.length)]; } const x = f.a.x + (f.b.x - f.a.x) * f.t; const y = f.a.y + (f.b.y - f.a.y) * f.t; const alpha = Math.sin(f.t * Math.PI); ctx.fillStyle = 'rgba(255, 255, 255, ' + (0.9 * alpha).toFixed(3) + ')'; ctx.beginPath(); ctx.arc(x, y, 2.4, 0, Math.PI * 2); ctx.fill(); }
        requestAnimationFrame(step); }
    window.addEventListener('resize', () => { resize(); initParticles(); initFlows(); }); resize(); initParticles(); initFlows(); step();
})();
</script>

<div class="beta-hero">
    <h1>GAIA <span class="accent">Beta Access</span></h1>
    <p>GAIA is in closed beta. Request access to run the full pipeline on your own data — genome read, variant mapping, compound ranking, protocol design, and the reversal simulation.</p>
    <form class="beta-form" action="https://formspree.io/f/xvkzyjdz" method="POST">
        <input type="email" name="email" placeholder="you@example.com" required>
        <input type="text" name="affiliation" placeholder="Affiliation (optional)">
        <textarea name="use_case" placeholder="What would you use GAIA for? (optional)"></textarea>
        <button type="submit">Request beta access</button>
    </form>
    <p style="font-family: ui-monospace; font-size: 0.75rem; color: rgba(167,243,208,0.5); margin-top: 12px;">No email yet — access requests will be collected and followed up manually.</p>
    <div class="beta-promise">
        <h3>What beta access includes</h3>
        <ul>
            <li>Full access to the genome-scanning pipeline</li>
            <li>Compound library screening across 25M+ molecules</li>
            <li>The reversal simulation — run protocols on your own disease model</li>
            <li>All datasets, all benchmarks, all intermediate outputs</li>
            <li>Direct line for feedback — the system is built by one person</li>
        </ul>
    </div>
    <a href="index.html" class="beta-back">← Back to GAIA</a>
</div>

<div id="earth-container" aria-hidden="true"></div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
const container = document.getElementById('earth-container');
if (container) {
    const scene = new THREE.Scene();
    
    // Hardcode the aspect ratio to 1.0 (Square).
    // This prevents the 3D engine from stretching the sphere into a flat polygon on wide screens.
    const camera = new THREE.PerspectiveCamera(35, 1.0, 0.1, 1000);
    
    // Position camera to look at the top curve of a massive sphere
    camera.position.z = 1.8; 
    camera.position.y = 0.2;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    
    // Force the renderer size to match the container but keep the camera square
    renderer.setSize(container.clientWidth, container.clientHeight);
    container.appendChild(renderer.domElement);

    const earthGeo = new THREE.SphereGeometry(1, 64, 64);
    const textureLoader = new THREE.TextureLoader();
    const earthTex = textureLoader.load('https://unpkg.com/three-globe@2.31.0/example/img/earth-blue-marble.jpg');
    earthTex.colorSpace = THREE.SRGBColorSpace;
    const earthMat = new THREE.MeshPhongMaterial({ map: earthTex, specular: new THREE.Color(0x333333), shininess: 15 });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    scene.add(earth);

    const cloudTex = textureLoader.load('https://unpkg.com/three-globe@2.31.0/example/img/clouds.png');
    cloudTex.colorSpace = THREE.SRGBColorSpace;
    const cloudMat = new THREE.MeshPhongMaterial({ map: cloudTex, transparent: true, opacity: 0.5, depthWrite: false });
    const clouds = new THREE.Mesh(new THREE.SphereGeometry(1.005, 64, 64), cloudMat);
    scene.add(clouds); clouds.name = 'clouds';

    const tintMat = new THREE.MeshBasicMaterial({ color: 0x4ade80, transparent: true, opacity: 0.15, blending: THREE.AdditiveBlending, depthWrite: false });
    const tint = new THREE.Mesh(new THREE.SphereGeometry(0.998, 64, 64), tintMat);
    scene.add(tint);

    const sun = new THREE.DirectionalLight(0xffffff, 4.0); sun.position.set(-3, 2, 2); scene.add(sun);
    const ambient = new THREE.AmbientLight(0x2a4a32, 1.5); scene.add(ambient);
    const rim = new THREE.DirectionalLight(0x4ade80, 1.0); rim.position.set(2, -1, -3); scene.add(rim);

    // Resize handler: stops the Earth from distorting if the window changes size
    window.addEventListener('resize', () => {
        renderer.setSize(container.clientWidth, container.clientHeight);
        // Intentionally DO NOT update camera.aspect here. We keep it at 1.0.
    });

    let t = 0;
    function tick() {
        t += 0.001; earth.rotation.y = t;
        if (clouds) clouds.rotation.y = t * 1.15;
        renderer.render(scene, camera); requestAnimationFrame(tick);
    }
    tick();
}
</script>
</body>
</html>
